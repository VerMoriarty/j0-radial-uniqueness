/-!
Reflection-based audit template. check_j0_radial.py prepends imports of every
current paper source module before running a private, snapshotted copy of this file.
No mathematical theorem is postulated here. Missing future paper wrappers are
reported as missing, while an existing wrapper with the wrong type is an error.
-/

open Lean Meta Elab Command Term MeasureTheory Laplacian J0RadialUniqueness
open scoped ContDiff Topology

namespace J0RadialAudit

def allowedAxioms : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]

/-- Monotone regression floor: every result already kernel-closed must stay closed. -/
def knownClosedTargets : Array Name := #[
  `J0RadialUniqueness.F_rightHalfPlane, `J0RadialUniqueness.noRealOnePoints,
  `J0RadialUniqueness.Q_zero_free, `J0RadialUniqueness.globalLocalization,
  `J0RadialUniqueness.paper_3_1, `J0RadialUniqueness.paper_3_2,
  `J0RadialUniqueness.paper_4_1, `J0RadialUniqueness.paper_4_2,
  `J0RadialUniqueness.paper_5_1, `J0RadialUniqueness.paper_5_2,
  `J0RadialUniqueness.paper_5_3, `J0RadialUniqueness.spectral_equivalence,
  `J0RadialUniqueness.paper_6_2, `J0RadialUniqueness.paper_6_3,
  `J0RadialUniqueness.paper_6_4, `J0RadialUniqueness.paper_6_5,
  `J0RadialUniqueness.PaperComplete,
  `J0RadialUniqueness.paper_boundary_finite_smooth_counterexample,
  `J0RadialUniqueness.paper_subcritical_smooth_counterexample,
  `J0RadialUniqueness.real_bessel_integral,
  `J0RadialUniqueness.paper_k0_boundary_connection,
  `J0RadialUniqueness.paper_k0_cosh_integral]

def isPaperModule (n : Name) : Bool :=
  (`Definitions.J0RadialUniqueness).isPrefixOf n ||
    (`Solutions.J0RadialUniqueness).isPrefixOf n

def isPaperName (n : Name) : Bool := (`J0RadialUniqueness).isPrefixOf n

def constantKind : ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .thmInfo _ => "theorem"
  | .defnInfo _ => "def"
  | .opaqueInfo _ => "opaque"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "ctor"
  | .recInfo _ => "recursor"
  | .quotInfo _ => "quotient"

/-- Lean >= 4.30: theorem proof values must be read from thmInfo.value. -/
def constantValue? : ConstantInfo → Option Expr
  | .thmInfo t => some t.value
  | .defnInfo d => some d.value
  | .opaqueInfo o => some o.value
  | _ => none

def namesJson (xs : Array Name) : Json :=
  toJson ((xs.map Name.toString).qsort (· < ·))

/-- Expand paper proposition aliases, including under quantifiers/conjunctions.
Do not unfold the actual functions F/J0, integrals, or the entire Mathlib definition graph.
This is a readable witness; actual target acceptance uses isDefEq below. -/
partial def expandPaperPropositions (e : Expr) (fuel : Nat := 128) : MetaM Expr := do
  if fuel == 0 then return e
  if let .const n _ := e.getAppFn then
    if isPaperName n && (← isProp e) then
      if let some (.defnInfo _) := (← getEnv).find? n then
        let e' ← withTransparency .all (whnf e)
        if e' != e then return ← expandPaperPropositions e' (fuel - 1)
  match e with
  | .forallE n t b bi =>
      let t' ← expandPaperPropositions t (fuel - 1)
      withLocalDecl n bi t' fun x => do
        mkForallFVars #[x] (← expandPaperPropositions (b.instantiate1 x) (fuel - 1))
  | .lam n t b bi =>
      let t' ← expandPaperPropositions t (fuel - 1)
      withLocalDecl n bi t' fun x => do
        mkLambdaFVars #[x] (← expandPaperPropositions (b.instantiate1 x) (fuel - 1))
  | .app f a =>
      return mkApp (← expandPaperPropositions f (fuel - 1))
        (← expandPaperPropositions a (fuel - 1))
  | .letE _ _ _ _ _ => expandPaperPropositions (← whnf e) (fuel - 1)
  | .mdata _ b => expandPaperPropositions b (fuel - 1)
  | .proj n i b => return .proj n i (← expandPaperPropositions b (fuel - 1))
  | _ => return e

def elaboratedExpected (stx : Syntax) : TermElabM Expr := do
  let e ← elabTerm stx none
  synthesizeSyntheticMVarsNoPostponing
  let e ← instantiateMVars e
  unless ← isProp e do throwError "audit expected a proposition"
  return e

def inspectTarget (label : String) (candidate : Name) (expected : Expr)
    (requiredNow : Bool := false) : MetaM Json := do
  let requiredNow := requiredNow || knownClosedTargets.contains candidate
  let expectedExpanded ← expandPaperPropositions expected
  let expectedText := (← ppExpr expectedExpanded).pretty
  let some actual := (← getEnv).find? candidate
    | return Json.mkObj [
        ("id", toJson label), ("candidate", toJson candidate.toString),
        ("status", toJson "missing"), ("required_now", toJson requiredNow),
        ("expected_type", toJson expectedText),
        ("expected_type_expr", toJson (reprStr expectedExpanded))]
  let sameType ← withTransparency .all (isDefEq actual.type expected)
  let axs ← Lean.collectAxioms candidate
  let bad := axs.filter (!allowedAxioms.contains ·)
  let isTheorem := match actual with | .thmInfo _ => true | _ => false
  let good := sameType && isTheorem && bad.isEmpty
  return Json.mkObj [
    ("id", toJson label), ("candidate", toJson candidate.toString),
    ("status", toJson (if good then "closed" else "invalid")),
    ("required_now", toJson requiredNow), ("kind", toJson (constantKind actual)),
    ("type_matches", toJson sameType), ("expected_type", toJson expectedText),
    ("expected_type_expr", toJson (reprStr expectedExpanded)),
    ("actual_type", toJson (← ppExpr (← expandPaperPropositions actual.type)).pretty),
    ("axioms", namesJson axs), ("unexpected_axioms", namesJson bad)]

def inspectNamedSpecification (label : String) (candidate : Name)
    (specs : Array Name) : TermElabM Json := do
  let mut expected? : Option Expr := none
  for spec in specs do
    let some ci := (← getEnv).find? spec
      | return Json.mkObj [
          ("id", toJson label), ("candidate", toJson candidate.toString),
          ("status", toJson "missing_specification"),
          ("missing_specification", toJson spec.toString), ("required_now", toJson false)]
    let e := Lean.mkConst spec (ci.levelParams.map Level.param)
    unless ← isProp e do throwError "{spec} is not a proposition specification"
    expected? := some (match expected? with
      | none => e
      | some old => mkApp2 (mkConst ``And) old e)
  let some expected := expected? | throwError "empty specification list for {label}"
  inspectTarget label candidate expected

/-- Completion is the conjunction of the sixteen actual target types, each of
which is independently checked above. A mutable completion alias cannot weaken it. -/
def inspectComplete : MetaM Json := do
  let candidate := `J0RadialUniqueness.PaperComplete
  let targets : Array Name := #[
    `J0RadialUniqueness.F_rightHalfPlane, `J0RadialUniqueness.noRealOnePoints,
    `J0RadialUniqueness.Q_zero_free, `J0RadialUniqueness.globalLocalization,
    `J0RadialUniqueness.paper_3_1, `J0RadialUniqueness.paper_3_2,
    `J0RadialUniqueness.paper_4_1, `J0RadialUniqueness.paper_4_2,
    `J0RadialUniqueness.paper_5_1, `J0RadialUniqueness.paper_5_2,
    `J0RadialUniqueness.paper_5_3, `J0RadialUniqueness.spectral_equivalence,
    `J0RadialUniqueness.paper_6_2, `J0RadialUniqueness.paper_6_3,
    `J0RadialUniqueness.paper_6_4, `J0RadialUniqueness.paper_6_5]
  let mut expected? : Option Expr := none
  for target in targets.reverse do
    let some ci := (← getEnv).find? target
      | return Json.mkObj [
          ("id", toJson "paper_complete"), ("candidate", toJson candidate.toString),
          ("status", toJson (if ((← getEnv).find? candidate).isSome then "invalid" else "missing")),
          ("missing_dependency", toJson target.toString), ("required_now", toJson false)]
    expected? := some (match expected? with
      | none => ci.type
      | some old => mkApp2 (Lean.mkConst ``And) ci.type old)
  let some expected := expected? | throwError "empty completion target list"
  inspectTarget "paper_complete" candidate expected

end J0RadialAudit

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
set_option pp.universes true in
set_option pp.fullNames true in
set_option format.width 2000 in
run_cmd do
  let document ← liftTermElabM do
    let env := (← getEnv).setExporting false
    setEnv env
    let mut declarations : Array Json := #[]
    let mut importedPaperModules : Array String := #[]
    for m in env.header.moduleNames do
      if J0RadialAudit.isPaperModule m then
        importedPaperModules := importedPaperModules.push m.toString
    for (n, ci) in env.constants.toList do
      let some idx := env.getModuleIdxFor? n | continue
      let m := env.header.moduleNames[idx]!
      unless J0RadialAudit.isPaperModule m do continue
      let axs ← Lean.collectAxioms n
      let expanded ← J0RadialAudit.expandPaperPropositions ci.type
      let sourceRange ← findDeclarationRanges? n
      let (startLine, endLine) := match sourceRange with
        | some r => (r.range.pos.line, r.range.endPos.line)
        | none => (0, 0)
      let valueDeps := match J0RadialAudit.constantValue? ci with
        | some v => v.getUsedConstants
        | none => #[]
      declarations := declarations.push <| Json.mkObj [
        ("name", toJson n.toString), ("module", toJson m.toString),
        ("kind", toJson (J0RadialAudit.constantKind ci)),
        ("private", toJson (privateToUserName? n).isSome),
        ("internal", toJson n.isInternal),
        ("user_name", toJson ((privateToUserName? n).getD n).toString),
        ("start_line", toJson startLine), ("end_line", toJson endLine),
        ("type", toJson (← ppExpr ci.type).pretty),
        ("type_expr", toJson (reprStr ci.type)),
        ("expanded_type", toJson (← ppExpr expanded).pretty),
        ("expanded_type_expr", toJson (reprStr expanded)),
        ("type_dependencies", J0RadialAudit.namesJson ci.type.getUsedConstants),
        ("value_dependencies", J0RadialAudit.namesJson valueDeps),
        ("axioms", J0RadialAudit.namesJson axs),
        ("unexpected_axioms", J0RadialAudit.namesJson (axs.filter (!J0RadialAudit.allowedAxioms.contains ·)))]
    let mut claims : Array Json := #[]
    claims := claims.push (← J0RadialAudit.inspectTarget "2.1" `J0RadialUniqueness.F_rightHalfPlane
      (← J0RadialAudit.elaboratedExpected (← `(∀ w : ℂ, w ≠ 0 → 0 ≤ w.re → 1 < ‖J0RadialUniqueness.F w‖))) true)
    claims := claims.push (← J0RadialAudit.inspectTarget "2.2" `J0RadialUniqueness.noRealOnePoints
      (← J0RadialAudit.elaboratedExpected (← `(∀ x : ℝ, x ≠ 0 → ‖J0RadialUniqueness.J0 (x : ℂ)‖ < 1))) true)
    claims := claims.push (← J0RadialAudit.inspectTarget "2.3" `J0RadialUniqueness.Q_zero_free
      (← J0RadialAudit.elaboratedExpected (← `(∀ w : ℂ, ‖w‖ < 4 → J0RadialUniqueness.Q w ≠ 0))) true)
    claims := claims.push (← J0RadialAudit.inspectTarget "2.4" `J0RadialUniqueness.globalLocalization
      (← J0RadialAudit.elaboratedExpected (← `(∀ z : ℂ, z ≠ 0 → J0RadialUniqueness.J0 z = 1 →
        0 < (z ^ 2).re ∧ z.im ≠ 0 ∧ 4 ≤ ‖z‖))) true)
    -- All sixteen expected claim types are independently written out here.
    -- In particular, no mutable paper `...Statement` alias is an acceptance oracle.
    -- Mathematical function definitions (J0, amplitudes, kernels and circularMean)
    -- are shared with the proof; the quantified propositions and domains are not.
    claims := claims.push (← J0RadialAudit.inspectTarget "3.1" `J0RadialUniqueness.paper_3_1
      (← J0RadialAudit.elaboratedExpected (← `(
        (DifferentiableOn ℂ J0RadialUniqueness.laplaceI Complex.slitPlane ∧
          DifferentiableOn ℂ J0RadialUniqueness.laplaceK Complex.slitPlane ∧
          ∀ w ∈ Complex.slitPlane,
            HasDerivAt J0RadialUniqueness.laplaceI
              ((1 / (4 * w ^ 2)) * J0RadialUniqueness.weightedIntegral
                (J0RadialUniqueness.laplaceMomentKernel w)) w) ∧
        (∀ w ∈ Complex.slitPlane,
          J0RadialUniqueness.laplaceK w = J0RadialUniqueness.K0Series w)))))
    claims := claims.push (← J0RadialAudit.inspectTarget "3.2" `J0RadialUniqueness.paper_3_2
      (← J0RadialAudit.elaboratedExpected (← `(
        (DifferentiableOn ℂ J0RadialUniqueness.APlus {z : ℂ | 0 < z.re} ∧
          DifferentiableOn ℂ J0RadialUniqueness.AMinus {z : ℂ | 0 < z.re} ∧
          ∀ z : ℂ, 0 < z.re →
            HasDerivAt J0RadialUniqueness.APlus
              (Complex.I / (4 * z ^ 2) * J0RadialUniqueness.weightedIntegral
                (J0RadialUniqueness.plusMomentKernel z)) z ∧
            HasDerivAt J0RadialUniqueness.AMinus
              (-Complex.I / (4 * z ^ 2) * J0RadialUniqueness.weightedIntegral
                (J0RadialUniqueness.minusMomentKernel z)) z) ∧
        (∀ z : ℂ, 0 < z.re →
          J0RadialUniqueness.J0 z =
            (Complex.exp (Complex.I * (z - (Real.pi : ℂ) / 4)) * J0RadialUniqueness.APlus z +
              Complex.exp (-Complex.I * (z - (Real.pi : ℂ) / 4)) * J0RadialUniqueness.AMinus z) /
            Complex.cpow (2 * (Real.pi : ℂ) * z) (1 / 2 : ℂ))))))
    claims := claims.push (← J0RadialAudit.inspectTarget "4.1" `J0RadialUniqueness.paper_4_1
      (← J0RadialAudit.elaboratedExpected (← `(
        (∀ z : ℂ, (0 ≤ z.im ∧ z.im ≤ z.re ∧ 0 < z.re) →
